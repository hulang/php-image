{
    "name": "hulang/php-image",
    "description": "The PHP 8.3.0+ Image Package (PHP 8.3 compatible, powered by Intervention Image 4.x)",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "intervention/image": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "preferred-install": "dist"
    },
    "autoload": {
        "psr-4": {
            "hulang\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests"
        }
    }
}
